<div class="form">
    <%= form_with url: flights_path, method: :get do |form| %>
      <div class="flight-form">
        <%= form.label :departure_airport_id, "From: "%> 
        <%= select_tag(:departure_airport_id, options_from_collection_for_select(@airports, :id, :code))%><br><br>

        <%= form.label :arrival_airport_id, "To: "%> 
        <%= select_tag(:arrival_airport_id, options_from_collection_for_select(@airports, :id, :code))%>
      </div><br>

      <div class="date-form">
        <% flight_dates = @flights.map(&:start_time) %>
        <% flight_date_formatted = flight_dates.map { |f| f.strftime(('%A, %B %e (%Y)'))}.uniq %>
        <%= form.label :start_time, "Date: " %>
        <%= select_tag(:start_time, options_for_select(flight_date_formatted))%>
      </div><br>

      <div class="passenger-form">
        <%= form.label :passengers_number, "Passengers number:" %><br><br>
        <%= form.select :passengers_number, (1..5) %>
      </div><br>

      <div>
        <%= form.submit "Search" %>
      </div>
      <%= params.inspect %>
    <% end %>
</div class="form">   
