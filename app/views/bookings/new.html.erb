<h1>Fill out Passenger Information</h1>

<div class="flight_box">
    <h2>Your Flight Details</h2>
    <p><strong><%= @flight.departure_airport.code %> -> <%= @flight.arrival_airport.code %></strong></p>
    <p><strong>Date:</strong> <%= @flight.start_time.strftime("%d %b %Y") %></p>
    <p><strong>Duration: </strong><%= @flight.human_duration %></p>
    <p><strong>Number of Passengers: </strong><%= @passengers_num %></p>
</div> 

<%= form_with model: @booking do |f| %>
    <%= f.fields_for :passengers do |sub_form| %>
        <%= sub_form.text_field :name %>
        <%= sub_form.text_field :email %>
    <% end %>
    <%= f.submit "Book Now" %>
<% end %>