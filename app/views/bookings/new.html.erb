<h1>Fill out Passenger Information</h1>

<div class="flight_box">
    <h2>Your Flight Details</h2>
    <p><strong><%= @flight.departure_airport.code %> -> <%= @flight.arrival_airport.code %></strong></p>
    <p><strong>Date:</strong> <%= @flight.start_time.strftime("%d %b %Y") %></p>
    <p><strong>Duration: </strong><%= @flight.human_duration %></p>
    <p><strong>Number of Passengers: </strong><%= @passengers_num %></p>
</div> 

<%= form_with model: @booking do |f| %>

    <% if @booking.errors.any? %>
    <div id="error_explanation">
        <h2><%= pluralize(@booking.errors.count, "error") %> Prevented this user from being saved:</h2>
        <ul>
            <% @booking.errors.full_messages.each do |error| %>
            <li><%= error %></li>
            <% end %>
        </ul>
    </div>
    <% end %>

    <% p = 1 %>

    <%= f.fields_for :passengers do |sub_form| %>
        <p><strong>Passenger</strong> <%= p %></p>
        <%= sub_form.text_field :name, style: "display: block",  placeholder: "name" %><br>
        <%= sub_form.text_field :email, style: "display: block",  placeholder: "email" %>
        <% p += 1 %>
    <% end %><br>
    <%= f.submit "Book Now" %>
<% end %>